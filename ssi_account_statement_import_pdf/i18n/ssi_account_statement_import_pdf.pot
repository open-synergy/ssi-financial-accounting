#. module: ssi_account_statement_import_pdf
#: model:ir.model.fields,help:ssi_account_statement_import_pdf.field_account_statement_import_pdf_mapping__parser_code
msgid ""
"Python code executed inside safe_eval to transform extracted PDF content "
"into bank statement data. Available input variables: pages (list[str] — one "
"entry per PDF page, text mode), full_text (str — all pages joined by "
"newline, text mode), tables (list[list[list]] — extracted tables, tables "
"mode), filename (str), re (module), datetime (module), date (datetime.date),"
" mapping (this record). Required output: set result['statements'] to a non-"
"empty list of statement dicts, each with a 'transactions' key containing "
"dicts with at minimum: date (str YYYY-MM-DD), amount (float), payment_ref "
"(str), unique_import_id (str). Optional output: result['currency_code'] (str"
" ISO 4217), result['account_number'] (str or None)."
msgstr ""

