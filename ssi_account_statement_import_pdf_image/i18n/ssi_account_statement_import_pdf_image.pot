#. module: ssi_account_statement_import_pdf_image
#: code:addons/ssi_account_statement_import_pdf_image/models/account_statement_import_pdf_image_mapping.py:0
#, python-format
msgid ""
"\n"
"Context: OCR-extract text from a scanned PDF file for bank statement import\n"
"Database ID: %s\n"
"Problem: OCR extraction failed: %s\n"
"Solution: Ensure 'tesseract-ocr' and 'poppler-utils' system binaries are installed on the Odoo image (odoo/custom/dependencies/apt.txt), and that the uploaded file is a valid PDF\n"
msgstr ""

#. module: ssi_account_statement_import_pdf_image
#: code:addons/ssi_account_statement_import_pdf_image/models/account_statement_import_pdf_image_mapping.py:0
#, python-format
msgid ""
"\n"
"Context: OCR-extract text from a scanned PDF file for bank statement import\n"
"Database ID: %s\n"
"Problem: Python library 'pytesseract' and/or 'pdf2image' is not installed\n"
"Solution: Install both by adding 'pytesseract' and 'pdf2image' to odoo/custom/dependencies/pip.txt, add 'tesseract-ocr' and 'poppler-utils' to odoo/custom/dependencies/apt.txt, then rebuild the Odoo image (invoke img_build)\n"
msgstr ""

