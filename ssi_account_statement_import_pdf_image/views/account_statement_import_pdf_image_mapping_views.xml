<odoo>
<record id="account_statement_import_pdf_image_mapping_view_search" model="ir.ui.view">
    <field name="name">account.statement.import.pdf.image.mapping - search</field>
    <field name="model">account.statement.import.pdf.image.mapping</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//group[@name='dom_active']" position="before">
                <field name="ocr_lang" />
            </xpath>
            <xpath expr="//group[@name='dom_active']" position="after">
                <group name="group_by">
                    <filter
                            name="grp_ocr_lang"
                            string="OCR Language"
                            context="{'group_by': 'ocr_lang'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="account_statement_import_pdf_image_mapping_view_tree" model="ir.ui.view">
    <field name="name">account.statement.import.pdf.image.mapping - tree</field>
    <field name="model">account.statement.import.pdf.image.mapping</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="before">
                <field name="ocr_lang" />
                <field name="currency_id" optional="hide" />
            </xpath>
        </data>
    </field>
</record>

<record id="account_statement_import_pdf_image_mapping_view_form" model="ir.ui.view">
    <field name="name">account.statement.import.pdf.image.mapping - form</field>
    <field name="model">account.statement.import.pdf.image.mapping</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//page[@name='note']" position="before">
                <page string="OCR Settings" name="ocr_settings">
                    <group>
                        <field name="ocr_lang" />
                        <field name="ocr_dpi" />
                        <field name="ocr_psm" />
                        <field name="currency_id" />
                    </group>
                    <separator string="Image Preprocessing" />
                    <group>
                        <field name="preprocess_enabled" />
                        <field
                                name="preprocess_grayscale"
                                attrs="{'invisible': [('preprocess_enabled', '=', False)]}"
                            />
                        <field
                                name="preprocess_autocontrast"
                                attrs="{'invisible': [('preprocess_enabled', '=', False)]}"
                            />
                        <field
                                name="preprocess_binarize"
                                attrs="{'invisible': [('preprocess_enabled', '=', False)]}"
                            />
                        <field
                                name="preprocess_threshold"
                                attrs="{'invisible': ['|', ('preprocess_enabled', '=', False), ('preprocess_binarize', '!=', 'global')]}"
                            />
                        <field
                                name="preprocess_deskew"
                                attrs="{'invisible': [('preprocess_enabled', '=', False)]}"
                            />
                        <field
                                name="preprocess_scale"
                                attrs="{'invisible': [('preprocess_enabled', '=', False)]}"
                            />
                    </group>
                    <separator string="Parser Code" />
                    <field name="parser_code" nolabel="1" widget="text" />
                </page>
            </xpath>
        </data>
    </field>
</record>

<record
        id="account_statement_import_pdf_image_mapping_action"
        model="ir.actions.act_window"
    >
    <field name="name">PDF Image Statement Mappings</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">account.statement.import.pdf.image.mapping</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="menu_account_statement_import_pdf_image_mapping"
        name="PDF Image Statement Mapping"
        parent="ssi_financial_accounting.menu_account_configuration"
        action="account_statement_import_pdf_image_mapping_action"
    />
</odoo>
