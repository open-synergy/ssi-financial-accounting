<odoo>
<record id="account_type_view_search" model="ir.ui.view">
    <field name="name">account_type - search</field>
    <field name="model">account_type</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="odoo_type_id" />
                <field name="direct_cash_flow_type_id" />
                <field name="indirect_cash_flow_type_id" />
            </xpath>
            <xpath expr="//group[@name='dom_active']" position="before">
                <separator name="reconcile" />
                <filter
                        name="dom_reconcile"
                        string="Reconcilable"
                        domain="[('reconcile', '=', True)]"
                    />
                <filter
                        name="dom_not_reconcile"
                        string="Non-Reconcilable"
                        domain="[('reconcile', '=', False)]"
                    />
            </xpath>
            <xpath expr="//group[@name='dom_active']" position="after">
                <group name="group_by">
                    <filter
                            name="grp_odoo_type"
                            string="Account Type (Odoo)"
                            context="{'group_by': 'odoo_type_id'}"
                        />
                    <filter
                            name="grp_direct_cash_flow_type"
                            string="Direct Cash Flow Type"
                            context="{'group_by': 'direct_cash_flow_type_id'}"
                        />
                    <filter
                            name="grp_indirect_cash_flow_type"
                            string="Indirect Cash Flow Type"
                            context="{'group_by': 'indirect_cash_flow_type_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="account_type_view_tree" model="ir.ui.view">
    <field name="name">account_type - tree</field>
    <field name="model">account_type</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[1]" position="before">
                <field name="sequence" widget="handle" />
            </xpath>
            <xpath expr="//field[@name='active']" position="before">
                <field name="odoo_type_id" />
                <field name="reconcile" />
                <field name="direct_cash_flow_type_id" />
                <field name="indirect_cash_flow_type_id" />
            </xpath>
        </data>
    </field>
</record>

<record id="account_type_view_form" model="ir.ui.view">
    <field name="name">account_type - form</field>
    <field name="model">account_type</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="before">
                <field name="odoo_type_id" />
                <field name="reconcile" />
                <field name="direct_cash_flow_type_id" />
                <field name="indirect_cash_flow_type_id" />
            </xpath>
        </data>
    </field>
</record>

<record id="account_type_action" model="ir.actions.act_window">
    <field name="name">Account Types</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">account_type</field>
    <field name="view_mode">tree,form</field>
</record>

</odoo>
