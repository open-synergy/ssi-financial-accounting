<odoo>
<record id="account_statement_import_mutasi_ai_form" model="ir.ui.view">
    <field name="name">account.statement.import.mutasi.ai</field>
    <field name="model">account.statement.import</field>
    <field
            name="inherit_id"
            ref="account_statement_import.account_statement_import_form"
        />
    <field name="arch" type="xml">
        <xpath expr="//ul[@id='statement_format']" position="inside">
            <li>
                Mutasi AI backend:
                <field name="mutasi_ai_backend_id" nolabel="1" />
            </li>
        </xpath>
    </field>
</record>
</odoo>
