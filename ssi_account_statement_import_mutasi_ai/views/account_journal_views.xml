<odoo>
<record id="account_journal_mutasi_ai_backend_form" model="ir.ui.view">
    <field name="name">account.journal.mutasi.ai.backend</field>
    <field name="model">account.journal</field>
    <field name="inherit_id" ref="account.view_account_journal_form" />
    <field name="arch" type="xml">
        <xpath expr="//field[@name='bank_statements_source']" position="after">
            <field
                    name="default_mutasi_ai_backend_id"
                    attrs="{'invisible': [('type', '!=', 'bank')]}"
                />
        </xpath>
    </field>
</record>
</odoo>
